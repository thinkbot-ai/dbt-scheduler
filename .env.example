# Copy this file to .env and replace placeholders.
# Never commit .env or real credentials.

NODE_ENV=development
LOG_LEVEL=info

# Process role is set by Docker Compose / process entrypoints.
# Valid values: api | scheduler | worker
PROCESS_ROLE=api

# API
PORT=4000
API_BIND_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://dbt_scheduler:dbt_scheduler@localhost:5432/dbt_scheduler
POSTGRES_USER=dbt_scheduler
POSTGRES_PASSWORD=dbt_scheduler
POSTGRES_DB=dbt_scheduler

# Concurrency
MAX_CONCURRENT_JOBS=10
WORKER_CONCURRENCY=2
WORKER_ID=

# Job lease / heartbeat
JOB_LEASE_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=15
SCHEDULER_TICK_INTERVAL_SECONDS=10

# Execution workspaces
WORKSPACE_ROOT=/workspaces
WORKSPACE_RETENTION_HOURS=24

# Git (never log this value)
GIT_TOKEN=

# DBT CLI
DBT_BIN=dbt
DBT_PYTHON_BIN=python3
DBT_CORE_VERSION=1.10.23
DBT_DREMIO_VERSION=1.10.1

# Simple V1 auth boundary (Phase 13). Leave empty to disable auth in local development.
API_AUTH_TOKEN=
