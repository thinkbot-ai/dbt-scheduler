{
  "name": "dbt-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight scheduling and orchestration for dbt-core + dbt-dremio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkbot-ai/dbt-scheduler.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && npm run typecheck -w @dbt-scheduler/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "dev:api": "npm run dev -w @dbt-scheduler/api",
    "dev:scheduler": "npm run dev -w @dbt-scheduler/scheduler",
    "dev:worker": "npm run dev -w @dbt-scheduler/worker",
    "dev:web": "npm run dev -w @dbt-scheduler/web"
  },
  "dependencies": {
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
